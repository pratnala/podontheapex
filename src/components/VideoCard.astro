---
import PlayButton from './PlayButton.astro';

const { video, isShort, hidden } = Astro.props;

const thumbnail = `https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`;
const colClasses = isShort ? 'col-6 col-md-4 col-lg-3' : 'col-12 col-md-6 col-lg-4';
---
<div class:list={[colClasses, 'video-item', { 'd-none': hidden }]} data-season={video.season}>
    <div class="card border-0 shadow-none text-center">
        {video.slug ? (
            <div class:list={['video-thumb', { 'short-video': isShort }]}>
                <img src={thumbnail} alt="" width="1280" height="720" loading="lazy" decoding="async">
                <PlayButton />
            </div>
        ) : (
            <a class:list={['video-thumb', { 'short-video': isShort }]} href={`https://www.youtube.com/watch?v=${video.id}`} data-video-id={video.id} data-video-title={video.title} aria-label={`Play ${video.title}`}>
                <img src={thumbnail} alt="" width="1280" height="720" loading="lazy" decoding="async">
                <PlayButton />
            </a>
        )}
        <div class="card-body">
            <p class="card-text">
                {video.slug ? <a class="stretched-link text-reset text-decoration-none" href={`/episodes/${video.slug}`}>{video.title}</a> : video.title}
            </p>
        </div>
    </div>
</div>
