---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

const { title, titleClass = 'display-3', description, logo } = Astro.props;
---
<div class="container py-5">
    <h1 class:list={[titleClass, 'fw-bold text-white mt-4 d-flex justify-content-center align-items-center']}>
        <Image src={logo} alt="" width={80} height={80} densities={[1, 2]} class="me-4 rounded-circle shadow flex-shrink-0" loading="eager" />
        <span>{title}</span>
    </h1>
    <p class="lead mb-4 fs-4">{description}</p>
    <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
        <a href="https://music.youtube.com/playlist?list=PLT70Wn9q0VdbVtaQ-ZQioK-w6big5L9Cl" target="_blank" rel="noopener" class="btn btn-youtube btn-lg px-4 rounded-pill shadow-sm">
            <Icon name="youtube-music" class="me-2" />YouTube
        </a>
        <a href="https://open.spotify.com/show/0jpcfqzb7Eymvde0PR1cI3" target="_blank" rel="noopener" class="btn btn-spotify btn-lg px-4 rounded-pill shadow-sm">
            <Icon name="spotify" class="me-2" />Spotify
        </a>
        <a href="https://podcasts.apple.com/us/podcast/pod-on-the-apex/id1795324786" target="_blank" rel="noopener" class="btn btn-apple btn-lg px-4 rounded-pill shadow-sm">
            <Icon name="podcast" class="me-2" />Apple
        </a>
        <a href="https://pca.st/tc9nckz7" target="_blank" rel="noopener" class="btn btn-pocketcasts btn-lg px-4 rounded-pill shadow-sm">
            <Icon name="pocket-casts" class="me-2" />Pocket Casts
        </a>
    </div>
</div>
