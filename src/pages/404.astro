---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logos/logo.png';
---
<Layout title="Page Not Found | Pod on the Apex" description="We couldn't find that page. It may have gone off the track!" logo={logo} slug="404" noindex>
    <div class="container text-center py-5">
        <p class="fs-4 mb-4">That page isn't on the racing line.</p>
        <a href="/" class="btn btn-youtube btn-lg px-4 rounded-pill shadow-sm">Back to the latest episodes</a>
    </div>
</Layout>
